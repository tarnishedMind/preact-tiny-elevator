{
  "name": "elevator",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "server": "tsx watch server/index.ts",
    "dev:all": "concurrently -n web,server -c blue,green \"npm:dev\" \"npm:server\"",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fortawesome/free-solid-svg-icons": "^7.0.0",
    "preact": "^10.29.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "concurrently": "^10.0.6",
    "sass": "^1.90.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0"
  }
}
